# SDR_OS reverse proxy
# HTTP fallback for local dev; HTTPS via Tailscale certs when available
#
# /ros/* proxies to rosbridge (network_mode: host on the Docker host).
# The webserver container is on a bridge network; rosbridge is on the host network.
# docker-compose sets extra_hosts: ["host-gateway:host-gateway"] so that the hostname
# "host-gateway" resolves to the Docker host's bridge gateway IP. If that entry is
# absent (legacy containers), 172.27.0.1 is the edge-network bridge gateway.

(sdr_routes) {
    @healthcheck path /health
    handle @healthcheck {
        log_skip
        respond "OK" 200
    }

    handle /stream/ws {
        reverse_proxy transport-server:8080 {
            flush_interval -1s
            transport http {
                read_timeout 0
            }
        }
    }

    @socketio path /socket.io/*
    handle @socketio {
        reverse_proxy node:3000
    }

    handle_path /ros {
        reverse_proxy 172.27.0.1:9090
    }
    handle_path /ros/* {
        reverse_proxy 172.27.0.1:9090
    }

    handle /api/* {
        reverse_proxy node:3000
    }

    handle {
        root * /srv/www
        try_files {path} /index.html
        file_server
    }
}

# HTTP — local/dev fallback (no TLS certs required)
:80 {
    log {
        output stdout
        format console
        level INFO
    }
    import sdr_routes
}

# HTTPS — Tailscale secure context (for Safari Gamepad API etc.)
https://amd-rtx.tail09c99.ts.net {
    tls /etc/caddy/tls/amd-rtx.tail09c99.ts.net.crt /etc/caddy/tls/amd-rtx.tail09c99.ts.net.key
    log {
        output stdout
        format console
        level INFO
    }
    import sdr_routes
}
